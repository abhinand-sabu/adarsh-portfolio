# ==============================================================================
# ADARSH PORTFOLIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development or set these environment
# variables in your deployment dashboard (Netlify / Vercel / Cloudflare Pages).
#
# 1. Create a Supabase project at: https://database.new
# 2. Run the database setup script located at ./supabase_schema.sql in the SQL Editor.
# 3. Obtain your Project URL and Publishable/Anon API key from Project Settings > API.
# ==============================================================================

# Supabase Project API URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous / Publishable Key (safe to use in browser client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
